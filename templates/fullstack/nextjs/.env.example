# The location of your instance of Seamless Auth.
AUTH_SERVER_URL=http://localhost:5312

# Secret shared between this application and Seamless Auth, 32 characters
# minimum. The value here only gets the application to boot; copy the real one
# from the portal before any call to Seamless Auth will be accepted.
API_SERVICE_TOKEN=GRAB_FROM_SEAMLESS_AUTH_PORTAL_DEV

# The key id the auth server signs tokens with.
JWKS_KID=dev-main

# Signs the session cookies this application issues. 32 characters minimum:
# openssl rand -base64 48
COOKIE_SIGNING_KEY=dev-only-cookie-signing-key-replace-me

# Optional cookie domain for production, for example .example.com
COOKIE_DOMAIN=

# What this application calls its auth cookies. Cookies ignore the port, so two
# Seamless applications on the same host share one cookie jar and sign each
# other out. Give each one its own prefix to run them side by side on localhost.
AUTH_COOKIE_PREFIX=
