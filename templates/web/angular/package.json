{
  "name": "seamless-auth-angular-starter",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=9.0.0 <13.0.0"
  },
  "scripts": {
    "ng": "ng",
    "predev": "node --env-file-if-exists=.env scripts/write-config.mjs",
    "dev": "ng serve",
    "start": "npm run dev",
    "prebuild": "node --env-file-if-exists=.env scripts/write-config.mjs",
    "build": "ng build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "author": "Fells Code LLC",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@seamless-auth/angular": "^0.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.3",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.29",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.0"
  }
}
