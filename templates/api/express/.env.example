# The location of your instance of Seamless Auth
AUTH_SERVER_URL=http://localhost:5312

# Serve the Seamless admin dashboard from this API at /console. Set to false when
# the console is hosted elsewhere (a standalone container) or not at all. When
# true, add this API's origin to the auth server's ORIGINS so passkey ceremonies
# started in the console verify — see README.
SERVE_ADMIN_CONSOLE=true

# Web origins allowed by CORS. Drop http://localhost:5174 when SERVE_ADMIN_CONSOLE
# is true (the console is same-origin here, not a separate 5174 container).
UI_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional cookie domain for production, for example .example.com
COOKIE_DOMAIN=

# Secret to sign API-generated cookies with
COOKIE_SIGNING_KEY=somethingSecret

# Secret shared between this API server and Seamless Auth
API_SERVICE_TOKEN=GRAB_FROM_SEAMLESS_AUTH_PORTAL

JWKS_KID=dev-main

DB_HOST=localhost
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=seamless_api

DB_LOGGING=false
