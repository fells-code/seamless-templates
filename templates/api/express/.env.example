# Development mode. Enables the dev messaging handlers below, which log OTP and
# magic-link tokens to this API's console instead of sending real email/SMS.
# Set to production before deploying.
NODE_ENV=development

# The location of your instance of Seamless Auth
AUTH_SERVER_URL=http://localhost:5312

# Serve the Seamless admin dashboard from this API at /console. Set to false when
# the console is hosted elsewhere (a standalone container) or not at all. When
# true, add this API's origin to the auth server's ORIGINS so passkey ceremonies
# started in the console verify (see README).
SERVE_ADMIN_CONSOLE=true

# Web origins allowed by CORS. Drop http://localhost:5174 when SERVE_ADMIN_CONSOLE
# is true (the console is same-origin here, not a separate 5174 container).
UI_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional cookie domain for production, for example .example.com
COOKIE_DOMAIN=

# Secret to sign API-generated cookies with. The adapter refuses to start on
# anything shorter than 32 characters, so replace this with a real one:
# openssl rand -base64 48
COOKIE_SIGNING_KEY=dev-only-cookie-signing-key-replace-me

# Secret shared between this API server and Seamless Auth. Also 32 characters
# minimum. The value here only gets the API to boot; copy the real one from the
# portal before any call to Seamless Auth will be accepted.
API_SERVICE_TOKEN=GRAB_FROM_SEAMLESS_AUTH_PORTAL_DEV

JWKS_KID=dev-main

# A managed Seamless database is handed out as a connection string. When set,
# DATABASE_URL wins over the discrete DB_* values below, and sslmode=require in
# it turns on TLS. `seamless init` writes it with placeholders for the user and
# password: copy those from the dashboard, they are never written to disk for you.
# DATABASE_URL=

# Only if your database presents a certificate that does not chain to a public
# CA. This drops protection against an intercepted connection.
# DB_SSL_REJECT_UNAUTHORIZED=false

DB_HOST=localhost
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=seamless_api

DB_LOGGING=false
