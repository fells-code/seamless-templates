{
  "targets": [
    "templates/web/react-vite",
    "templates/web/react-oauth",
    {
      "path": "templates/fullstack/nextjs",
      "only": ["index.css", "fonts"]
    },
    {
      "path": "templates/web/angular",
      "only": ["index.css", "fonts"]
    },
    {
      "path": "templates/web/vue",
      "only": ["index.css", "fonts"]
    },
    {
      "path": "templates/web/svelte",
      "only": ["index.css", "fonts"],
      "to": {
        "fonts": "static/fonts"
      }
    }
  ],
  "files": [
    {
      "from": "index.css",
      "to": "src/index.css"
    },
    {
      "from": "layouts/Layout.tsx",
      "to": "src/layouts/Layout.tsx"
    },
    {
      "from": "components/kit",
      "to": "src/components/kit"
    },
    {
      "from": "lib",
      "to": "src/lib"
    },
    {
      "from": "fonts",
      "to": "public/fonts"
    }
  ]
}
